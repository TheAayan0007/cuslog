#!/usr/bin/env python3
"""
Customize Dock & Panels: Modern Qt6 GUI and CLI utility to customize KDE Plasma 6
Bottom Dock (Icons-Only Task Manager) and Top Bar panel heights, curves, transparency,
size, padding, floating modes, and blur — with independent control of Top Bar and Dock curvatures.
"""

import os
import sys
import json
import argparse
import subprocess
import shutil

CONFIG_FILE = os.path.expanduser("~/.config/customize-dock.json")
THEME_DIR = os.path.expanduser("~/.local/share/plasma/desktoptheme/kali")
CACHE_DIR = os.path.expanduser("~/.cache")

DEFAULT_CONFIG = {
    "radius": 32,             # Backward compatibility alias for dock_radius
    "dock_radius": 32,
    "top_radius": 8,
    "transparency": 60,
    "dock_height": 94,
    "dock_floating": True,
    "dock_remove_border": False,
    "dock_opacity_mode": 2,  # 2: Translucent, 0: Adaptive, 1: Opaque
    "top_height": 46,
    "top_floating": True,
    "top_remove_border": False,
    "top_opacity_mode": 2,
    "top_length_mode": "fill",  # fill or fit
    "pad_x": 22,
    "pad_y": 8,
    "blur": True,
    "blur_strength": 10,
    "auto_apply": False
}

BREEZE_DEFAULTS = {
    "radius": 6,
    "dock_radius": 6,
    "top_radius": 6,
    "transparency": 15,
    "dock_height": 48,
    "dock_floating": True,
    "dock_remove_border": False,
    "dock_opacity_mode": 0,
    "top_height": 38,
    "top_floating": False,
    "top_remove_border": False,
    "top_opacity_mode": 0,
    "top_length_mode": "fill",
    "pad_x": 8,
    "pad_y": 4,
    "blur": True,
    "blur_strength": 10,
    "auto_apply": False
}

def load_config():
    cfg = dict(DEFAULT_CONFIG)
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                data = json.load(f)
                # Handle migrations
                if "height" in data and "dock_height" not in data:
                    data["dock_height"] = data["height"]
                if "radius" in data and "dock_radius" not in data:
                    data["dock_radius"] = data["radius"]
                if "dock_radius" in data and "radius" not in data:
                    data["radius"] = data["dock_radius"]
                cfg.update(data)
        except Exception:
            pass
    return cfg

def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        json.dump(cfg, f, indent=2)

def generate_svg(radius, opacity, pad_x, pad_y, panel_height=46, show_border=True):
    rx = max(1, radius)
    # ry cannot exceed half of panel height minus 4 to avoid FrameSvg minimumDrawingHeight clashing
    max_ry = max(2, int(panel_height / 2) - 4)
    ry = max(1, min(rx, max_ry))
    W = 32
    H = 32

    # Cubic bezier constants
    k = 0.55228475
    cx = round(rx * (1 - k), 3)
    rx_minus_cx = round(rx - cx, 3)
    cy = round(ry * (1 - k), 3)
    ry_minus_cy = round(ry - cy, 3)

    X_frame = 10
    Y_frame = 10
    X_mask = X_frame + (2 * rx + W) + 40
    Y_mask = Y_frame
    total_w = X_mask + (2 * rx + W) + 40
    total_h = Y_frame + (2 * ry + H) + 40

    path_tl = f"M 0,{ry} H {rx} V 0 C {cx},0 0,{cy} 0,{ry} Z"
    path_tr = f"M 0,0 V {ry} H {rx} C {rx},{cy} {rx_minus_cx},0 0,0 Z"
    path_bl = f"M {rx},{ry} V 0 H 0 C 0,{ry_minus_cy} {cx},{ry} {rx},{ry} Z"
    path_br = f"M 0,{ry} V 0 H {rx} C {rx},{ry_minus_cy} {rx_minus_cx},{ry} 0,{ry} Z"

    border_opacity = min(1.0, opacity + 0.15)
    top_border = f'\n    <path d="M 0,0 V 1 H {W} V 0 Z" class="ColorScheme-Background" style="opacity:{border_opacity};fill:currentColor"/>' if show_border else ""
    left_border = f'\n    <path d="M 0,{H} H 1 V 0 H 0 Z" class="ColorScheme-Background" style="opacity:{border_opacity};fill:currentColor"/>' if show_border else ""
    right_border = f'\n    <path d="M {rx - 1},{H} H {rx} V 0 H {rx - 1} Z" class="ColorScheme-Background" style="opacity:{border_opacity};fill:currentColor"/>' if show_border else ""
    bottom_border = f'\n    <path d="M 0,{ry - 1} V {ry} H {W} V {ry - 1} Z" class="ColorScheme-Background" style="opacity:{border_opacity};fill:currentColor"/>' if show_border else ""

    return f"""<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="{total_w}" height="{total_h}" viewBox="0 0 {total_w} {total_h}">
  <defs>
    <style id="current-color-scheme" type="text/css">
      .ColorScheme-Background {{ color: #eff0f1; }}
      .ColorScheme-ViewBackground {{ color: #1e1e1e; }}
    </style>
  </defs>

  <!-- FRAME PIECES -->
  <g id="topleft" transform="translate({X_frame},{Y_frame})">
    <path d="{path_tl}" class="ColorScheme-Background" style="opacity:{opacity};fill:currentColor"/>
  </g>
  <g id="top" transform="translate({X_frame + rx},{Y_frame})">
    <rect x="0" y="0" width="{W}" height="{ry}" class="ColorScheme-Background" style="opacity:{opacity};fill:currentColor"/>{top_border}
  </g>
  <g id="topright" transform="translate({X_frame + rx + W},{Y_frame})">
    <path d="{path_tr}" class="ColorScheme-Background" style="opacity:{opacity};fill:currentColor"/>
  </g>
  <g id="left" transform="translate({X_frame},{Y_frame + ry})">
    <rect x="0" y="0" width="{rx}" height="{H}" class="ColorScheme-Background" style="opacity:{opacity};fill:currentColor"/>{left_border}
  </g>
  <g id="center" transform="translate({X_frame + rx},{Y_frame + ry})">
    <rect x="0" y="0" width="{W}" height="{H}" class="ColorScheme-Background" style="opacity:{opacity};fill:currentColor"/>
  </g>
  <g id="right" transform="translate({X_frame + rx + W},{Y_frame + ry})">
    <rect x="0" y="0" width="{rx}" height="{H}" class="ColorScheme-Background" style="opacity:{opacity};fill:currentColor"/>{right_border}
  </g>
  <g id="bottomleft" transform="translate({X_frame},{Y_frame + ry + H})">
    <path d="{path_bl}" class="ColorScheme-Background" style="opacity:{opacity};fill:currentColor"/>
  </g>
  <g id="bottom" transform="translate({X_frame + rx},{Y_frame + ry + H})">
    <rect x="0" y="0" width="{W}" height="{ry}" class="ColorScheme-Background" style="opacity:{opacity};fill:currentColor"/>{bottom_border}
  </g>
  <g id="bottomright" transform="translate({X_frame + rx + W},{Y_frame + ry + H})">
    <path d="{path_br}" class="ColorScheme-Background" style="opacity:{opacity};fill:currentColor"/>
  </g>

  <!-- MARGIN HINTS -->
  <rect id="hint-top-margin" x="{X_frame + rx + 10}" y="{Y_frame}" width="4" height="{pad_y}" style="fill:#ff00ff"/>
  <rect id="hint-bottom-margin" x="{X_frame + rx + 10}" y="{Y_frame + 2*ry + H - pad_y}" width="4" height="{pad_y}" style="fill:#ff00ff"/>
  <rect id="hint-left-margin" x="{X_frame}" y="{Y_frame + ry + 10}" width="{pad_x}" height="4" style="fill:#ff00ff"/>
  <rect id="hint-right-margin" x="{X_frame + 2*rx + W - pad_x}" y="{Y_frame + ry + 10}" width="{pad_x}" height="4" style="fill:#ff00ff"/>

  <rect id="hint-top-inset" x="{X_frame + rx + 10}" y="{Y_frame}" width="4" height="0.001" style="fill:#00ff00"/>
  <rect id="hint-bottom-inset" x="{X_frame + rx + 10}" y="{Y_frame + 2*ry + H}" width="4" height="0.001" style="fill:#00ff00"/>
  <rect id="hint-left-inset" x="{X_frame}" y="{Y_frame + ry + 10}" width="0.001" height="4" style="fill:#00ff00"/>
  <rect id="hint-right-inset" x="{X_frame + 2*rx + W}" y="{Y_frame + ry + 10}" width="0.001" height="4" style="fill:#00ff00"/>

  <!-- THICK MARGIN HINTS -->
  <rect id="thick-center" x="{X_frame + rx}" y="{Y_frame + ry}" width="{W}" height="{H}" class="ColorScheme-Background" style="opacity:{opacity};fill:currentColor"/>
  <rect id="thick-hint-top-margin" x="{X_frame + rx + 10}" y="{Y_frame}" width="4" height="{pad_y}" style="fill:#800080"/>
  <rect id="thick-hint-bottom-margin" x="{X_frame + rx + 10}" y="{Y_frame + 2*ry + H - pad_y}" width="4" height="{pad_y}" style="fill:#800080"/>
  <rect id="thick-hint-left-margin" x="{X_frame}" y="{Y_frame + ry + 10}" width="{pad_x}" height="4" style="fill:#800080"/>
  <rect id="thick-hint-right-margin" x="{X_frame + 2*rx + W - pad_x}" y="{Y_frame + ry + 10}" width="{pad_x}" height="4" style="fill:#800080"/>

  <!-- MASK ELEMENTS -->
  <g id="mask-topleft" transform="translate({X_mask},{Y_mask})">
    <path d="{path_tl}" style="fill:#000000"/>
  </g>
  <rect id="mask-top" x="{X_mask + rx}" y="{Y_mask}" width="{W}" height="{ry}" style="fill:#000000"/>
  <g id="mask-topright" transform="translate({X_mask + rx + W},{Y_mask})">
    <path d="{path_tr}" style="fill:#000000"/>
  </g>
  <rect id="mask-left" x="{X_mask}" y="{Y_mask + ry}" width="{rx}" height="{H}" style="fill:#000000"/>
  <rect id="mask-center" x="{X_mask + rx}" y="{Y_mask + ry}" width="{W}" height="{H}" style="fill:#000000"/>
  <rect id="mask-right" x="{X_mask + rx + W}" y="{Y_mask + ry}" width="{rx}" height="{H}" style="fill:#000000"/>
  <g id="mask-bottomleft" transform="translate({X_mask},{Y_mask + ry + H})">
    <path d="{path_bl}" style="fill:#000000"/>
  </g>
  <rect id="mask-bottom" x="{X_mask + rx}" y="{Y_mask + ry + H}" width="{W}" height="{ry}" style="fill:#000000"/>
  <g id="mask-bottomright" transform="translate({X_mask + rx + W},{Y_mask + ry + H})">
    <path d="{path_br}" style="fill:#000000"/>
  </g>
</svg>
"""

def apply_dock_settings(cfg):
    dock_radius = cfg.get("dock_radius", cfg.get("radius", 32))
    top_radius = cfg.get("top_radius", 8)
    # Synchronize radius keys
    cfg["dock_radius"] = dock_radius
    cfg["radius"] = dock_radius
    cfg["top_radius"] = top_radius

    transparency = cfg.get("transparency", 60)
    dock_height = cfg.get("dock_height", 94)
    dock_floating = cfg.get("dock_floating", True)
    dock_remove_border = cfg.get("dock_remove_border", False)
    dock_opacity_mode = cfg.get("dock_opacity_mode", 2)
    top_height = cfg.get("top_height", 46)
    top_floating = cfg.get("top_floating", True)
    top_remove_border = cfg.get("top_remove_border", False)
    top_opacity_mode = cfg.get("top_opacity_mode", 2)
    top_length_mode = cfg.get("top_length_mode", "fill")
    pad_x = cfg.get("pad_x", 22)
    pad_y = cfg.get("pad_y", 8)
    blur = cfg.get("blur", True)
    blur_strength = cfg.get("blur_strength", 10)

    opacity = max(0.02, min(1.0, round(1.0 - (transparency / 100.0), 2)))

    # Generate separate SVGs: one for Dock (panel-background.svg) and one for Top Bar (top-panel-background.svg)
    dock_svg = generate_svg(
        radius=dock_radius,
        opacity=opacity,
        pad_x=pad_x,
        pad_y=pad_y,
        panel_height=dock_height,
        show_border=not dock_remove_border,
    )
    top_svg = generate_svg(
        radius=top_radius,
        opacity=opacity,
        pad_x=12,
        pad_y=4,
        panel_height=top_height,
        show_border=not top_remove_border,
    )

    subdirs = ["widgets", "solid/widgets", "translucent/widgets", "opaque/widgets"]
    for sub in subdirs:
        d = os.path.join(THEME_DIR, sub)
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, "panel-background.svg"), "w") as f:
            f.write(dock_svg)
        with open(os.path.join(d, "top-panel-background.svg"), "w") as f:
            f.write(top_svg)

    # Copy theme metadata & plasmarc if not present
    if not os.path.exists(os.path.join(THEME_DIR, "metadata.json")):
        sys_meta = "/usr/share/plasma/desktoptheme/kali/metadata.json"
        if os.path.exists(sys_meta):
            shutil.copy(sys_meta, THEME_DIR)
    if not os.path.exists(os.path.join(THEME_DIR, "plasmarc")):
        sys_plasmarc = "/usr/share/plasma/desktoptheme/kali/plasmarc"
        if os.path.exists(sys_plasmarc):
            shutil.copy(sys_plasmarc, THEME_DIR)

    plasmashellrc_path = os.path.expanduser("~/.config/plasmashellrc")
    kwinrc_path = os.path.expanduser("~/.config/kwinrc")

    # 1. Update KWin Blur
    blur_str = "true" if blur else "false"
    subprocess.run(["kwriteconfig6", "--file", kwinrc_path, "--group", "Plugins", "--key", "blurEnabled", blur_str], check=False)
    if blur:
        subprocess.run(["kwriteconfig6", "--file", kwinrc_path, "--group", "Effect-blur", "--key", "BlurStrength", str(blur_strength)], check=False)
        subprocess.run(["qdbus6", "org.kde.KWin", "/Effects", "org.kde.kwin.Effects.loadEffect", "blur"], check=False)
        subprocess.run(["qdbus6", "org.kde.KWin", "/Effects", "org.kde.kwin.Effects.reconfigureEffect", "blur"], check=False)
    else:
        subprocess.run(["qdbus6", "org.kde.KWin", "/Effects", "org.kde.kwin.Effects.unloadEffect", "blur"], check=False)

    # 2. Update Bottom Dock (Panel 239)
    dock_flt_int = "1" if dock_floating else "0"
    subprocess.run(["kwriteconfig6", "--file", plasmashellrc_path, "--group", "PlasmaViews", "--group", "Panel 239", "--group", "Defaults", "--key", "thickness", str(dock_height)], check=False)
    subprocess.run(["kwriteconfig6", "--file", plasmashellrc_path, "--group", "PlasmaViews", "--group", "Panel 239", "--key", "floating", dock_flt_int], check=False)
    subprocess.run(["kwriteconfig6", "--file", plasmashellrc_path, "--group", "PlasmaViews", "--group", "Panel 239", "--key", "panelOpacity", str(dock_opacity_mode)], check=False)

    # 3. Update Top Bar (Panel 217)
    top_flt_int = "1" if top_floating else "0"
    subprocess.run(["kwriteconfig6", "--file", plasmashellrc_path, "--group", "PlasmaViews", "--group", "Panel 217", "--group", "Defaults", "--key", "thickness", str(top_height)], check=False)
    subprocess.run(["kwriteconfig6", "--file", plasmashellrc_path, "--group", "PlasmaViews", "--group", "Panel 217", "--key", "floating", top_flt_int], check=False)
    subprocess.run(["kwriteconfig6", "--file", plasmashellrc_path, "--group", "PlasmaViews", "--group", "Panel 217", "--key", "panelOpacity", str(top_opacity_mode)], check=False)
    if top_length_mode == "fill":
        subprocess.run(["kwriteconfig6", "--file", plasmashellrc_path, "--group", "PlasmaViews", "--group", "Panel 217", "--key", "panelLengthMode", "0"], check=False)
    else:
        subprocess.run(["kwriteconfig6", "--file", plasmashellrc_path, "--group", "PlasmaViews", "--group", "Panel 217", "--key", "panelLengthMode", "1"], check=False)

    dock_flt_js = "true" if dock_floating else "false"
    top_flt_js = "true" if top_floating else "false"
    top_len_int = 0 if top_length_mode == "fill" else 1
    js_update = f"""
    var p239 = panelById(239);
    if (p239) {{
        p239.height = {dock_height};
        p239.floating = {dock_flt_js};
    }}
    var p217 = panelById(217);
    if (p217) {{
        p217.height = {top_height};
        p217.floating = {top_flt_js};
        p217.lengthMode = {top_len_int};
    }}
    """

    # 4. Clear SVG theme cache
    if os.path.exists(CACHE_DIR):
        for item in os.listdir(CACHE_DIR):
            if item.startswith("plasma_theme_") and item.endswith(".kcache"):
                try:
                    os.remove(os.path.join(CACHE_DIR, item))
                except Exception:
                    pass

    # 5. Restart plasmashell for theme changes
    subprocess.run(["systemctl", "--user", "reset-failed", "plasma-plasmashell"], check=False)
    subprocess.run(["systemctl", "--user", "restart", "plasma-plasmashell"], check=False)

    # 6. Apply dimensions via JS evaluateScript once plasmashell is back up
    import time
    for _ in range(10):
        time.sleep(0.4)
        res = subprocess.run(["qdbus6", "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript", js_update], capture_output=True, text=True, check=False)
        if res.returncode == 0:
            break

    save_config(cfg)

def reset_to_breeze():
    """Resets BOTH top bar and bottom dock completely to default Breeze appearance, dimensions, curves, and opacity."""
    cfg = dict(BREEZE_DEFAULTS)
    apply_dock_settings(cfg)


# ==========================================
# MODERN QT6 USER INTERFACE
# ==========================================
def launch_gui():
    from PyQt6.QtWidgets import (
        QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
        QLabel, QSlider, QPushButton, QTabWidget, QCheckBox, QComboBox,
        QGroupBox, QFrame, QMessageBox
    )
    from PyQt6.QtCore import Qt
    from PyQt6.QtGui import QPainter, QColor, QBrush, QLinearGradient, QFont

    app = QApplication(sys.argv)
    app.setStyle("Fusion")

    cfg = load_config()

    class DualPanelPreviewWidget(QFrame):
        """Paints a simulated desktop with BOTH top bar and bottom dock."""
        def __init__(self, parent=None):
            super().__init__(parent)
            self.setMinimumHeight(140)
            self.setMaximumHeight(155)
            self.dock_radius = cfg.get("dock_radius", cfg.get("radius", 32))
            self.top_radius = cfg.get("top_radius", 8)
            self.transparency = cfg.get("transparency", 60)
            self.dock_height = cfg.get("dock_height", 94)
            self.dock_floating = cfg.get("dock_floating", True)
            self.dock_remove_border = cfg.get("dock_remove_border", False)
            self.top_height = cfg.get("top_height", 46)
            self.top_floating = cfg.get("top_floating", True)
            self.top_remove_border = cfg.get("top_remove_border", False)
            self.pad_x = cfg.get("pad_x", 22)
            self.blur = cfg.get("blur", True)

        def update_params(
            self,
            dock_radius,
            top_radius,
            transparency,
            dock_h,
            dock_flt,
            top_h,
            top_flt,
            pad_x,
            blur,
            dock_remove_border=False,
            top_remove_border=False,
        ):
            self.dock_radius = dock_radius
            self.top_radius = top_radius
            self.transparency = transparency
            self.dock_height = dock_h
            self.dock_floating = dock_flt
            self.dock_remove_border = dock_remove_border
            self.top_height = top_h
            self.top_floating = top_flt
            self.top_remove_border = top_remove_border
            self.pad_x = pad_x
            self.blur = blur
            self.update()

        def paintEvent(self, event):
            painter = QPainter(self)
            painter.setRenderHint(QPainter.RenderHint.Antialiasing)

            w = self.width()
            h = self.height()

            # 1. Wallpaper background
            grad = QLinearGradient(0, 0, 0, h)
            grad.setColorAt(0.0, QColor(30, 70, 125))
            grad.setColorAt(0.65, QColor(55, 105, 170))
            grad.setColorAt(1.0, QColor(35, 45, 60))
            painter.setBrush(QBrush(grad))
            painter.setPen(Qt.PenStyle.NoPen)
            painter.drawRoundedRect(0, 0, w, h, 8, 8)

            # Background geometric silhouettes to visualize transparency
            painter.setBrush(QColor(255, 255, 255, 40))
            painter.drawRect(int(w * 0.12), int(h * 0.15), int(w * 0.15), int(h * 0.75))
            painter.drawRect(int(w * 0.70), int(h * 0.10), int(w * 0.20), int(h * 0.85))

            alpha = int(255 * (1.0 - self.transparency / 100.0))
            panel_color = QColor(22, 26, 34, max(15, alpha))

            # 2. Draw TOP BAR preview
            top_scale = 0.45
            top_h_px = max(14, int(self.top_height * top_scale))
            top_r = min(int(self.top_radius * top_scale), int(top_h_px / 2)) if self.top_floating else 0

            if self.top_floating:
                top_w_px = int(w * 0.94)
                top_x = int((w - top_w_px) / 2)
                top_y = 6
                painter.setBrush(QBrush(panel_color))
                painter.setPen(Qt.PenStyle.NoPen if self.top_remove_border else QColor(255, 255, 255, 30))
                painter.drawRoundedRect(top_x, top_y, top_w_px, top_h_px, top_r, top_r)
            else:
                top_w_px = w
                top_x = 0
                top_y = 0
                painter.setBrush(QBrush(panel_color))
                painter.setPen(Qt.PenStyle.NoPen)
                painter.drawRect(top_x, top_y, top_w_px, top_h_px)
                if not self.top_remove_border:
                    painter.setPen(QColor(255, 255, 255, 30))
                    painter.drawLine(0, top_h_px, w, top_h_px)

            # Simulated top bar widgets
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(QColor(255, 255, 255, 180))
            painter.drawRect(top_x + 10, top_y + int((top_h_px - 4) / 2), 24, 4)
            painter.drawRect(top_x + 40, top_y + int((top_h_px - 4) / 2), 16, 4)
            # Clock & tray on right
            painter.drawRect(top_x + top_w_px - 34, top_y + int((top_h_px - 4) / 2), 22, 4)
            painter.drawRect(top_x + top_w_px - 60, top_y + int((top_h_px - 4) / 2), 18, 4)

            # 3. Draw BOTTOM DOCK preview
            dock_scale = 0.52
            dock_h_px = int(self.dock_height * dock_scale)
            dock_w_px = min(int(w * 0.80), 420)
            dock_x = int((w - dock_w_px) / 2)
            dock_y = h - dock_h_px - (8 if self.dock_floating else 0)
            dock_r = min(int(self.dock_radius * dock_scale), int(dock_h_px / 2)) if self.dock_floating else 0

            painter.setBrush(QBrush(panel_color))
            painter.setPen(
                QColor(255, 255, 255, 30)
                if (self.dock_floating and not self.dock_remove_border)
                else Qt.PenStyle.NoPen
            )
            painter.drawRoundedRect(dock_x, dock_y, dock_w_px, dock_h_px, dock_r, dock_r)

            # 4. Draw simulated icons inside dock
            icon_colors = [
                QColor(30, 144, 255),   # Kali
                QColor(30, 30, 30),     # Terminal
                QColor(60, 130, 240),   # Dolphin
                QColor(245, 90, 40),    # Brave
                QColor(140, 90, 230),   # Antigravity
                QColor(0, 122, 204),    # VS Code
                QColor(30, 215, 96),    # Spotify
                QColor(255, 140, 0),    # VLC
                QColor(35, 110, 180),   # Steam
                QColor(40, 160, 160)    # Settings
            ]

            num_icons = len(icon_colors)
            pad_scaled = int(self.pad_x * dock_scale)
            usable_w = dock_w_px - 2 * pad_scaled
            icon_slot = usable_w / max(1, num_icons)
            icon_size = max(12, int(dock_h_px * 0.54))

            for i, c in enumerate(icon_colors):
                cx = int(dock_x + pad_scaled + i * icon_slot + (icon_slot - icon_size) / 2)
                cy = int(dock_y + (dock_h_px - icon_size) / 2)
                painter.setBrush(c)
                painter.setPen(Qt.PenStyle.NoPen)
