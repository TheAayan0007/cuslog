                self.top_floating_check.setChecked(BREEZE_DEFAULTS["top_floating"])
                self.top_remove_border_check.setChecked(BREEZE_DEFAULTS["top_remove_border"])
                self.blur_check.setChecked(BREEZE_DEFAULTS["blur"])
                self.bs_slider.setValue(BREEZE_DEFAULTS["blur_strength"])
                idx = self.mode_combo.findData(BREEZE_DEFAULTS["dock_opacity_mode"])
                if idx >= 0:
                    self.mode_combo.setCurrentIndex(idx)
                idx_len = self.top_length_combo.findData(BREEZE_DEFAULTS["top_length_mode"])
                if idx_len >= 0:
                    self.top_length_combo.setCurrentIndex(idx_len)
                self.update_preview()
                self.status_label.setText("✓ Both top bar and bottom dock successfully reset to Breeze defaults!")

    window = MainWindow()
    window.show()
    sys.exit(app.exec())


