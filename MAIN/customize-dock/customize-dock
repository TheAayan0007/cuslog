            self.status_label.setText(
                f"✓ Applied! Dock: {cfg_current['dock_height']}px (Curve {cfg_current['dock_radius']}px) | "
                f"Top: {cfg_current['top_height']}px (Curve {cfg_current['top_radius']}px) | "
                f"Trans: {cfg_current['transparency']}%"
            )

        def on_reset(self):
            confirm = QMessageBox.question(
                self,
                "Reset Both Panels to Breeze Defaults",
                "Reset both top bar and bottom dock heights, curves, and transparency back to Breeze default theme?",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
            )
            if confirm == QMessageBox.StandardButton.Yes:
                self.status_label.setText("Resetting both panels to Breeze defaults...")
                QApplication.processEvents()
                reset_to_breeze()

                # Update UI controls to Breeze defaults
                self.dock_r_slider.setValue(BREEZE_DEFAULTS["dock_radius"])
                self.top_r_slider.setValue(BREEZE_DEFAULTS["top_radius"])
                self.t_slider.setValue(BREEZE_DEFAULTS["transparency"])
