                top_flt=self.top_floating_check.isChecked(),
                pad_x=self.px_slider.value(),
                blur=self.blur_check.isChecked(),
                dock_remove_border=self.dock_remove_border_check.isChecked(),
                top_remove_border=self.top_remove_border_check.isChecked(),
