# CLI ENTRYPOINT
# ==========================================
def main():
    parser = argparse.ArgumentParser(description="Customize KDE Plasma Dock & Top Bar heights, curvature, transparency, size, and blur")
    parser.add_argument("--gui", action="store_true", help="Force launch Qt6 GUI")
    parser.add_argument("--radius", "-r", type=int, default=None, help="Dock corner radius in pixels (alias for --dock-radius)")
    parser.add_argument("--dock-radius", type=int, default=None, help="Bottom Dock corner radius in pixels")
    parser.add_argument("--top-radius", type=int, default=None, help="Top Bar corner radius in pixels")
    parser.add_argument("--transparency", "-t", type=int, default=None, help="Transparency percentage 0-100")
    parser.add_argument("--dock-height", "-H", type=int, default=None, help="Bottom Dock height / thickness in pixels")
    parser.add_argument("--top-height", "-T", type=int, default=None, help="Top Bar height / thickness in pixels")
    parser.add_argument("--padx", type=int, default=None, help="Horizontal padding in pixels")
    parser.add_argument("--blur", type=str, choices=["on", "off"], default=None, help="Enable or disable blur")
    parser.add_argument("--dock-border", type=str, choices=["on", "off"], default=None, help="Show or remove border/outline on Bottom Dock")
    parser.add_argument("--top-border", type=str, choices=["on", "off"], default=None, help="Show or remove border/outline on Top Bar")
    parser.add_argument("--reset", action="store_true", help="Reset both panels to Breeze default theme")
    args = parser.parse_args()

    if args.reset:
        reset_to_breeze()
        print("Reset both panels to default Breeze theme.")
        return

    has_cli_args = any(
        x is not None
        for x in [
            args.radius,
            args.dock_radius,
            args.top_radius,
            args.transparency,
            args.dock_height,
            args.top_height,
            args.padx,
            args.blur,
            args.dock_border,
            args.top_border,
        ]
    )
    if has_cli_args and not args.gui:
        cfg = load_config()
        if args.dock_radius is not None:
            cfg["dock_radius"] = args.dock_radius
            cfg["radius"] = args.dock_radius
        elif args.radius is not None:
            cfg["dock_radius"] = args.radius
            cfg["radius"] = args.radius
        if args.top_radius is not None:
            cfg["top_radius"] = args.top_radius
        if args.transparency is not None:
            cfg["transparency"] = args.transparency
        if args.dock_height is not None:
            cfg["dock_height"] = args.dock_height
        if args.top_height is not None:
            cfg["top_height"] = args.top_height
        if args.padx is not None:
            cfg["pad_x"] = args.padx
        if args.blur is not None:
            cfg["blur"] = (args.blur == "on")
        if args.dock_border is not None:
            cfg["dock_remove_border"] = (args.dock_border == "off")
        if args.top_border is not None:
            cfg["top_remove_border"] = (args.top_border == "off")

        apply_dock_settings(cfg)
        print(
            f"Applied: Dock Height={cfg['dock_height']}px (Curve={cfg['dock_radius']}px), "
            f"Top Bar Height={cfg['top_height']}px (Curve={cfg['top_radius']}px), "
            f"Transparency={cfg['transparency']}%"
        )
        return

    launch_gui()

if __name__ == "__main__":
    main()
