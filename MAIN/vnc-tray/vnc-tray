        root.addWidget(self.autostart_cb)

        btn_row = QtWidgets.QHBoxLayout()
        btn_row.addStretch()

        cancel_btn = QtWidgets.QPushButton("Cancel")
        cancel_btn.clicked.connect(self.reject)
        btn_row.addWidget(cancel_btn)

        save_btn = QtWidgets.QPushButton(
            "Save & Restart VNC" if is_running else "Save Settings"
        )
        save_btn.setObjectName("primaryBtn")
        save_btn.setDefault(True)
        save_btn.clicked.connect(self._on_accept)
        btn_row.addWidget(save_btn)
        root.addLayout(btn_row)

        self._sync_backend_ui()

    def _sync_backend_ui(self) -> None:
        is_remote = self.backend_combo.currentData() == "remote_control"
        self.unattended_cb.setEnabled(is_remote)
        self.name_edit.setEnabled(not is_remote)
        self.disp_group.setEnabled(not is_remote)
        if is_remote:
            self.mode_hint.setText(
                "Uses krfb + Wayland RemoteDesktop portal: when starting, click Share on KDE's popup "
                "to pick your screen (or Virtual Output) & allow cursor/keyboard, then enter your VNC password on iPhone."
            )
        else:
            self.mode_hint.setText(
                "Uses krfb-virtualmonitor: creates an instant 2nd screen with auto layout (no popup, view-only from iPhone)."
            )

    def _toggle_pw_visibility(self, checked: bool) -> None:
        self.pw_edit.setEchoMode(
            QtWidgets.QLineEdit.EchoMode.Normal
            if checked
            else QtWidgets.QLineEdit.EchoMode.Password
        )
        self.show_pw_btn.setText("Hide" if checked else "Show")

    def _generate_pw(self) -> None:
        self.pw_edit.setText(generate_password(8))
        self.show_pw_btn.setChecked(True)

    def _on_preset_changed(self, idx: int) -> None:
        data = self.preset_combo.itemData(idx)
        if not data:
            return
        w, h = data
        if w > 0 and h > 0:
            self.width_spin.blockSignals(True)
            self.height_spin.blockSignals(True)
            self.width_spin.setValue(w)
            self.height_spin.setValue(h)
            self.width_spin.blockSignals(False)
            self.height_spin.blockSignals(False)

    def _sync_custom_preset(self) -> None:
        w = self.width_spin.value()
        h = self.height_spin.value()
        for i, (_, pw, ph) in enumerate(RESOLUTION_PRESETS):
            if pw == w and ph == h:
                self.preset_combo.blockSignals(True)
                self.preset_combo.setCurrentIndex(i)
                self.preset_combo.blockSignals(False)
                return
        self.preset_combo.blockSignals(True)
        self.preset_combo.setCurrentIndex(len(RESOLUTION_PRESETS) - 1)
        self.preset_combo.blockSignals(False)

    def _on_accept(self) -> None:
        if not self.pw_edit.text().strip():
            QtWidgets.QMessageBox.warning(
                self,
                "Password Required",
                "VNC password cannot be empty.",
            )
            self.pw_edit.setFocus()
            return
        self.accept()

    def result_config(self) -> dict[str, Any]:
        """Return validated configuration dictionary from the dialog inputs."""
        return {
            "server_backend": str(self.backend_combo.currentData() or "remote_control"),
            "password": self.pw_edit.text().strip(),
            "allow_unattended": self.unattended_cb.isChecked(),
            "port": self.port_spin.value(),
            "display_name": sanitize_display_name(self.name_edit.text()),
            "layout_mode": str(self.layout_combo.currentData() or "right"),
            "width": self.width_spin.value(),
            "height": self.height_spin.value(),
            "scale": float(self.scale_combo.currentData() or 1.0),
            "auto_start_service": self.autostart_cb.isChecked(),
        }


