        sec_form.addRow("", self.pw_hint)

        self.unattended_cb = QtWidgets.QCheckBox(
            "Authenticate on iPhone with password directly (skip extra Accept popup on Kali)"
        )
        self.unattended_cb.setChecked(bool(cfg.get("allow_unattended", True)))
        sec_form.addRow("", self.unattended_cb)

        net_row = QtWidgets.QHBoxLayout()
        self.port_spin = QtWidgets.QSpinBox()
        self.port_spin.setRange(5900, 5999)
