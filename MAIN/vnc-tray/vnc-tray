        self.name_edit.setPlaceholderText("iPhoneDisplay")
        net_row.addWidget(self.name_edit, 1)
        sec_form.addRow("VNC Port:", net_row)

        root.addWidget(sec_group)

        # --- Display & Layout (for Virtual Monitor mode) ---
        self.disp_group = QtWidgets.QGroupBox("2nd Display Resolution & Position (View-Only Mode)")
        disp_form = QtWidgets.QFormLayout(self.disp_group)
        disp_form.setSpacing(10)

