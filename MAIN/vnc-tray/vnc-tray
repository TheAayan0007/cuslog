class VncTrayApp(QtCore.QObject):
    """Main controller managing the top-bar tray icon, VNC server modes, and layout."""

    def __init__(self, app: QtWidgets.QApplication) -> None:
        super().__init__()
        self.app = app
        self.config = load_config()
        self.state = "stopped"
        self.log_lines: list[str] = []
        self.virtual_output_name: str | None = None
        self._active_backend: str | None = None
        self._outputs_before_start: set[str] = set()
        self._layout_poll_tries = 0
        self._startup_poll_tries = 0
        self._pending_restart = False
        self._manual_stop = False
        self._log_dialog: LogViewerDialog | None = None
        self._info_dialog: ConnectionInfoDialog | None = None
        self._settings_dialog: SettingsDialog | None = None

        self.process = QtCore.QProcess(self)
        self.process.setProcessChannelMode(QtCore.QProcess.ProcessChannelMode.MergedChannels)
        self.process.readyReadStandardOutput.connect(self._on_process_output)
        self.process.finished.connect(self._on_process_finished)
        self.process.errorOccurred.connect(self._on_process_error)

        self._layout_timer = QtCore.QTimer(self)
        self._layout_timer.setInterval(350)
        self._layout_timer.timeout.connect(self._poll_and_apply_layout)

        self._startup_poll_timer = QtCore.QTimer(self)
        self._startup_poll_timer.setInterval(400)
        self._startup_poll_timer.timeout.connect(self._poll_server_listening)

        self.tray = QtWidgets.QSystemTrayIcon(self)
        self.tray.activated.connect(self._on_tray_activated)

        self._build_menu()
        self._sync_ui()
        self.tray.show()

        self._setup_ipc_server()

        if self.config.get("auto_start_service", False):
            QtCore.QTimer.singleShot(500, self.start_service)

    def _setup_ipc_server(self) -> None:
        QtNetwork.QLocalServer.removeServer(IPC_SERVER_NAME)
        self.ipc_server = QtNetwork.QLocalServer(self)
        self.ipc_server.listen(IPC_SERVER_NAME)
        self.ipc_server.newConnection.connect(self._on_ipc_connection)

    def _on_ipc_connection(self) -> None:
        conn = self.ipc_server.nextPendingConnection()
        if not conn:
            return
        conn.readyRead.connect(lambda: self._handle_ipc_message(conn))

    def _handle_ipc_message(self, conn: QtNetwork.QLocalSocket) -> None:
        msg = bytes(conn.readAll()).decode("utf-8", errors="ignore").strip()
        conn.close()
        if msg == "TOGGLE":
            self.toggle_service()
        else:
            self.open_settings()

    def _build_menu(self) -> None:
        self.menu = QtWidgets.QMenu()

        self.status_action = self.menu.addAction("")
        self.status_action.setEnabled(False)
        self.menu.addSeparator()

        self.toggle_action = self.menu.addAction("Start VNC Server")
        self.toggle_action.triggered.connect(self.toggle_service)

        self.info_action = self.menu.addAction("iPhone Connection Info...")
        self.info_action.triggered.connect(self.open_connection_info)

        self.settings_action = self.menu.addAction("Settings & Password...")
        self.settings_action.triggered.connect(self.open_settings)

        self.backend_menu = self.menu.addMenu("Control Mode")
        self.backend_group = QtGui.QActionGroup(self)
        self.backend_group.setExclusive(True)
        self.backend_actions: dict[str, QtGui.QAction] = {}
        for key, label in SERVER_BACKENDS:
            act = self.backend_menu.addAction(label.split(" (")[0])
            act.setCheckable(True)
            act.triggered.connect(lambda checked, b=key: self.set_server_backend(b))
            self.backend_group.addAction(act)
            self.backend_actions[key] = act

        self.layout_menu = self.menu.addMenu("2nd Screen Layout")
        self.layout_group = QtGui.QActionGroup(self)
        self.layout_group.setExclusive(True)
        self.layout_actions: dict[str, QtGui.QAction] = {}
        for mode_key, mode_label in LAYOUT_CHOICES:
            act = self.layout_menu.addAction(mode_label.split(" (")[0])
            act.setCheckable(True)
            act.triggered.connect(lambda checked, m=mode_key: self.set_layout_mode(m))
            self.layout_group.addAction(act)
            self.layout_actions[mode_key] = act

        self.logs_action = self.menu.addAction("View Status / Logs...")
        self.logs_action.triggered.connect(self.open_logs)

        self.viewer_action = self.menu.addAction("Test Locally (VNC Viewer)")
        self.viewer_action.triggered.connect(self.launch_local_viewer)

        self.menu.addSeparator()

        self.quit_action = self.menu.addAction("Close / Quit Tray")
        self.quit_action.triggered.connect(self.quit_app)

        self.tray.setContextMenu(self.menu)

    def is_active(self) -> bool:
        """Return True if the VNC server process is starting or running."""
        return self.process.state() != QtCore.QProcess.ProcessState.NotRunning

    def _sync_ui(self) -> None:
        ip = get_primary_ip()
        port = self.config["port"]
        backend = self.config["server_backend"]
        b_label = backend_label(backend)
        mode = self.config["layout_mode"]
        mode_short = layout_label(mode)
        self.tray.setIcon(build_tray_icon(self.state))

        if backend in self.backend_actions:
            self.backend_actions[backend].setChecked(True)
        if mode in self.layout_actions:
            self.layout_actions[mode].setChecked(True)
        self.layout_menu.setEnabled(backend == "virtual_monitor")

        if self.state == "running":
            self.status_action.setText(f"● Active: {ip}:{port} ({b_label})")
            self.toggle_action.setText("Stop VNC Server")
            self.tray.setToolTip(
                f"VNC Server: ON ({ip}:{port})\n"
                f"Mode: {b_label}\n"
                "Left-click to stop • Right-click for info & settings"
            )
        elif self.state == "starting":
            hint = "Approve KDE popup..." if backend == "remote_control" else f"port {port}..."
            self.status_action.setText(f"◐ Starting VNC ({hint})")
            self.toggle_action.setText("Stop VNC Server")
            self.tray.setToolTip(f"VNC Server: Starting on {ip}:{port} ({hint})")
        elif self.state == "error":
            self.status_action.setText(f"! Error starting VNC (port {port})")
            self.toggle_action.setText("Start VNC Server")
            self.tray.setToolTip(
                "VNC Server: Error\nLeft-click to retry • Right-click for logs"
            )
        else:
            detail = b_label if backend == "remote_control" else mode_short
            self.status_action.setText(f"○ Stopped — {detail} (Port {port})")
            self.toggle_action.setText("Start VNC Server")
            self.tray.setToolTip(
                f"VNC Server: OFF ({ip}:{port}) • {b_label}\n"
                "Left-click to start • Right-click for password & mode"
            )

        if self._log_dialog is not None and self._log_dialog.isVisible():
            self._log_dialog.refresh()
        if self._info_dialog is not None and self._info_dialog.isVisible():
            self._info_dialog.refresh()

    def _append_log(self, line: str) -> None:
        self.log_lines.append(line)
        if len(self.log_lines) > 400:
            self.log_lines = self.log_lines[-400:]
        if self._log_dialog is not None and self._log_dialog.isVisible():
            self._log_dialog.append_line(line)

    def _on_tray_activated(self, reason: QtWidgets.QSystemTrayIcon.ActivationReason) -> None:
        if reason in (
            QtWidgets.QSystemTrayIcon.ActivationReason.Trigger,
            QtWidgets.QSystemTrayIcon.ActivationReason.DoubleClick,
        ):
            self.toggle_service()
        elif reason == QtWidgets.QSystemTrayIcon.ActivationReason.MiddleClick:
            self.open_settings()

    def toggle_service(self) -> None:
        """Start VNC 2nd Display if stopped, or stop it if running."""
        if self.is_active():
            self.stop_service()
        else:
            self.start_service()

    def _handle_external_krfb(self) -> bool:
        """Detect pre-existing krfb or krfb-virtualmonitor processes and offer to stop them."""
        found = find_external_krfb_pids()
        if not found:
            return True
        summary = ", ".join(f"{name} ({pid})" for pid, name in found)
        reply = QtWidgets.QMessageBox.question(
            None,
            "Existing VNC Server Process Found",
            f"Another VNC process is already running: {summary}.\n\n"
            "Stop the existing instance so VNC 2nd Display can manage it cleanly?",
        )
        if reply != QtWidgets.QMessageBox.StandardButton.Yes:
            return False
        for pid, _ in found:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        QtCore.QThread.msleep(450)
        return True

    def start_service(self) -> None:
        """Start VNC server (krfb with mouse/keyboard control or krfb-virtualmonitor)."""
        if self.is_active():
            return

        backend = self.config["server_backend"]
        if backend == "virtual_monitor" and not is_wayland_session():
            QtWidgets.QMessageBox.warning(
                None,
                "Wayland Required for Virtual 2nd Screen",
                "Virtual 2nd Display requires a KDE Plasma Wayland session.\n"
                "Switch Control Mode to 'Mouse & Keyboard Control (krfb)' on X11.",
            )
            return

        exe = "krfb" if backend == "remote_control" else "krfb-virtualmonitor"
        if not shutil.which(exe):
            QtWidgets.QMessageBox.critical(
                None,
                f"{exe} Not Found",
                "The 'krfb' package is not installed yet.\n\n"
                "Run the installer to set it up automatically:\n"
                "python3 ~/Desktop/utils/MAIN/installer.py --only vnc-tray",
            )
            return

        if not self._handle_external_krfb():
            return

        port = int(self.config["port"])
        if is_port_in_use(port):
            QtWidgets.QMessageBox.warning(
                None,
                "Port Already in Use",
                f"TCP port {port} is already in use by another program.\n"
                "Choose a different port (e.g. 5901) in Settings.",
            )
            self.open_settings()
            return

        self._active_backend = backend
        self.virtual_output_name = None
        self._manual_stop = False
        self.state = "starting"

        if backend == "remote_control":
            if not sync_krfb_config(self.config):
                self._append_log(">>> Warning: kwriteconfig6 failed; krfb may use existing ~/.config/krfbrc")
            args = ["--nodialog"]
            self._append_log(">>> Starting: krfb --nodialog (mouse & keyboard enabled via RemoteDesktop portal)")
            if is_wayland_session():
                self.tray.showMessage(
                    "Approve Remote Control on Kali",
                    "Pick your screen (or Virtual Output) & click Share in KDE's popup.",
                    QtWidgets.QSystemTrayIcon.MessageIcon.Information,
                    4500,
                )
        else:
            self._outputs_before_start = {
                o.get("name", "") for o in get_kscreen_outputs() if o.get("name")
            }
            res_str = f"{self.config['width']}x{self.config['height']}"
            args = [
                "--resolution",
                res_str,
                "--name",
                self.config["display_name"],
                "--password",
                self.config["password"],
                "--port",
                str(port),
                "--scale",
                f"{self.config['scale']:g}",
            ]
            safe_args = [
                "***" if i > 0 and args[i - 1] == "--password" else a
                for i, a in enumerate(args)
            ]
            self._append_log(f">>> Starting: krfb-virtualmonitor {' '.join(safe_args)}")

        self._sync_ui()
        self.process.start(exe, args)
        self._startup_poll_tries = 0
        self._startup_poll_timer.start()

    def stop_service(self, for_restart: bool = False) -> None:
        """Gracefully terminate the managed VNC server process."""
        self._layout_timer.stop()
        self._startup_poll_timer.stop()
        self._pending_restart = for_restart
        if not self.is_active():
            self.state = "stopped"
            self.virtual_output_name = None
            self._active_backend = None
            self._sync_ui()
            if for_restart:
                self._pending_restart = False
                QtCore.QTimer.singleShot(250, self.start_service)
            return

        self._manual_stop = True
        exe = "krfb" if self._active_backend == "remote_control" else "krfb-virtualmonitor"
        self._append_log(f">>> Stopping {exe}...")
        self.process.terminate()
        QtCore.QTimer.singleShot(2500, self._force_kill_if_stuck)

    def _force_kill_if_stuck(self) -> None:
        if self._manual_stop and self.is_active():
            self._append_log(">>> Force killing unresponsive VNC process...")
            self.process.kill()

    def _poll_server_listening(self) -> None:
        if not self.is_active() or self.state != "starting":
            self._startup_poll_timer.stop()
            return
        self._startup_poll_tries += 1
        if is_port_in_use(int(self.config["port"])):
            self._startup_poll_timer.stop()
            self._confirm_started()
            return
        if self._startup_poll_tries >= 240:
            self._startup_poll_timer.stop()
            self._append_log(">>> Timed out waiting for VNC listen port.")

    def _on_process_output(self) -> None:
        raw = bytes(self.process.readAllStandardOutput()).decode("utf-8", errors="replace")
        error_markers = (
            "Failed to start server",
            "unable to load plugin",
            "Couldn't initialize XDP-KDE",
            "Couldn't select sources",
            "Couldn't select devices",
            "No devices were granted",
            "Failed to start screencast",
        )
        for line in raw.splitlines():
            clean = line.rstrip()
            if not clean:
                continue
            self._append_log(clean)

            if "Starting server. Listen port:" in clean and self.state == "starting":
                self._startup_poll_timer.stop()
                QtCore.QTimer.singleShot(200, self._confirm_started)
            elif any(marker in clean for marker in error_markers):
                self._startup_poll_timer.stop()
                self.state = "error"
                self._sync_ui()
                self.tray.showMessage(
                    "VNC Server Error",
                    clean,
                    QtWidgets.QSystemTrayIcon.MessageIcon.Critical,
                    5000,
                )

    def _confirm_started(self) -> None:
        if self.is_active() and self.state == "starting":
            self._startup_poll_timer.stop()
            self.state = "running"
            self._sync_ui()
            if self._active_backend == "virtual_monitor":
                self._layout_poll_tries = 0
                self._layout_timer.start()
            ip = get_primary_ip()
            port = self.config["port"]
            ctrl_note = (
                " (Mouse & Keyboard ON)"
                if self._active_backend == "remote_control"
                else " (2nd Display)"
            )
            self.tray.showMessage(
                f"VNC Ready{ctrl_note}",
                f"Connect iPhone VNC Viewer to {ip}:{port}",
                QtWidgets.QSystemTrayIcon.MessageIcon.Information,
                4000,
            )

    def _detect_virtual_output(self, outputs: list[dict[str, Any]]) -> dict[str, Any] | None:
        """Find the virtual monitor output created by krfb-virtualmonitor."""
        target_name = self.config["display_name"]
        for out in outputs:
            name = str(out.get("name", ""))
            if name == target_name or (name and name not in self._outputs_before_start):
                return out
        for out in outputs:
            name = str(out.get("name", ""))
            if name.startswith("Virtual") or target_name.lower() in name.lower():
                return out
        return None

    def _pick_primary_output(
        self, outputs: list[dict[str, Any]], virtual_name: str
    ) -> dict[str, Any] | None:
        """Pick the main physical laptop/desktop output (lowest priority or first non-virtual)."""
        candidates = [
            o for o in outputs if o.get("name") != virtual_name and o.get("enabled", True)
        ]
        if not candidates:
            return None
        candidates.sort(key=lambda o: int(o.get("priority", 99) or 99))
        return candidates[0]

    def _poll_and_apply_layout(self) -> None:
        self._layout_poll_tries += 1
        outputs = get_kscreen_outputs()
        virt = self._detect_virtual_output(outputs)
        if virt is not None:
            self._layout_timer.stop()
            self.virtual_output_name = str(virt.get("name"))
            self._append_log(f">>> Detected virtual display output: {self.virtual_output_name}")
            self.apply_virtual_layout()
            self._sync_ui()
            return
        if self._layout_poll_tries >= 18:
            self._layout_timer.stop()
            self._append_log(">>> Virtual output not listed by kscreen-doctor yet; use Re-apply Layout if needed.")

    def apply_virtual_layout(self) -> None:
        """Position or mirror the virtual display relative to the primary laptop screen."""
        if not shutil.which("kscreen-doctor"):
            return
        outputs = get_kscreen_outputs()
        virt = self._detect_virtual_output(outputs)
        if virt is None:
            return
        virt_name = str(virt["name"])
        self.virtual_output_name = virt_name
        primary = self._pick_primary_output(outputs, virt_name)
        if primary is None:
            return

        prim_name = str(primary["name"])
        prim_w, prim_h = logical_size(primary)
        virt_w, virt_h = logical_size(virt)
        mode = self.config["layout_mode"]

        cmd = ["kscreen-doctor", f"output.{prim_name}.enable", f"output.{virt_name}.enable"]
        if mode == "mirror":
            cmd.append(f"output.{virt_name}.mirror.{prim_name}")
        else:
            if int(virt.get("replicationSource", 0) or 0) != 0:
                cmd.append(f"output.{virt_name}.mirror.none")
            if mode == "right":
                cmd.extend([
                    f"output.{prim_name}.position.0,0",
                    f"output.{virt_name}.position.{prim_w},0",
                ])
            elif mode == "left":
                cmd.extend([
                    f"output.{virt_name}.position.0,0",
                    f"output.{prim_name}.position.{virt_w},0",
                ])
            elif mode == "above":
                cmd.extend([
                    f"output.{virt_name}.position.0,0",
                    f"output.{prim_name}.position.0,{virt_h}",
                ])
            elif mode == "below":
                cmd.extend([
                    f"output.{prim_name}.position.0,0",
                    f"output.{virt_name}.position.0,{prim_h}",
                ])

        self._append_log(f">>> Applying layout ({mode}): {' '.join(cmd)}")
        res = subprocess.run(cmd, capture_output=True, text=True, check=False)
        if res.returncode != 0 and mode == "mirror":
            fallback = [
                "kscreen-doctor",
                f"output.{prim_name}.position.0,0",
                f"output.{virt_name}.position.0,0",
            ]
            self._append_log(f">>> Mirror flag fallback: {' '.join(fallback)}")
            subprocess.run(fallback, capture_output=True, text=True, check=False)
        elif res.returncode != 0 and res.stderr.strip():
            self._append_log(f">>> kscreen-doctor note: {res.stderr.strip()}")

    def _restore_primary_origin(self) -> None:
        """Reset primary screen back to 0,0 after stopping a left/above virtual screen."""
        outputs = get_kscreen_outputs()
        if len(outputs) == 1:
            name = outputs[0].get("name")
            pos = outputs[0].get("pos") or {}
            if name and (pos.get("x", 0) != 0 or pos.get("y", 0) != 0):
                subprocess.run(
                    ["kscreen-doctor", f"output.{name}.position.0,0"],
                    check=False,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )

    def set_server_backend(self, backend: str) -> None:
        """Switch between Mouse & Keyboard Control (krfb) and 2nd Display Only."""
        if self.config["server_backend"] != backend:
            self.config["server_backend"] = backend
            save_config(self.config)
            self._sync_ui()
            if self.is_active():
                self.stop_service(for_restart=True)

    def set_layout_mode(self, mode: str) -> None:
        """Switch layout mode from the tray menu and apply immediately if running."""
        if self.config["layout_mode"] != mode:
            self.config["layout_mode"] = mode
            save_config(self.config)
            self._sync_ui()
        if self.is_active() and self._active_backend == "virtual_monitor":
            self.apply_virtual_layout()

    def _on_process_finished(
        self, exit_code: int, _exit_status: QtCore.QProcess.ExitStatus
    ) -> None:
        self._layout_timer.stop()
        self._startup_poll_timer.stop()
        exe = "krfb" if self._active_backend == "remote_control" else "krfb-virtualmonitor"
        self._append_log(f">>> {exe} exited (code {exit_code})")
        was_virtual = self._active_backend == "virtual_monitor"
        self.virtual_output_name = None
        self._active_backend = None
        was_manual = self._manual_stop
        restart = self._pending_restart
        self._manual_stop = False
        self._pending_restart = False

        if was_virtual:
            QtCore.QTimer.singleShot(250, self._restore_primary_origin)

        if restart:
            self.state = "stopped"
            self._sync_ui()
            QtCore.QTimer.singleShot(300, self.start_service)
            return

        if was_manual:
            self.state = "stopped"
            self.tray.showMessage(
                "VNC Server Stopped",
                "VNC screen sharing server is now off.",
                QtWidgets.QSystemTrayIcon.MessageIcon.Information,
                2500,
            )
        elif self.state != "error":
            self.state = "error" if exit_code != 0 else "stopped"
        self._sync_ui()

    def _on_process_error(self, error: QtCore.QProcess.ProcessError) -> None:
        self._layout_timer.stop()
        self._startup_poll_timer.stop()
        self._active_backend = None
        self._append_log(f">>> Process error: {error}")
        self.state = "error"
        self._sync_ui()

    def open_settings(self) -> None:
        """Open the GUI password & display settings dialog."""
        if self._settings_dialog is not None and self._settings_dialog.isVisible():
            self._settings_dialog.raise_()
            self._settings_dialog.activateWindow()
            return

        was_running = self.is_active()
        dialog = SettingsDialog(self.config, was_running)
        self._settings_dialog = dialog
        if dialog.exec() == QtWidgets.QDialog.DialogCode.Accepted:
            new_cfg = dialog.result_config()
            changed = new_cfg != self.config
            only_layout_changed = (
                changed
                and self._active_backend == "virtual_monitor"
                and all(
                    new_cfg[k] == self.config[k]
                    for k in new_cfg
                    if k not in ("layout_mode", "auto_start_service")
                )
            )
            self.config = new_cfg
            save_config(self.config)
            self._sync_ui()
            if changed and was_running:
                if only_layout_changed:
                    self.apply_virtual_layout()
                else:
                    self.stop_service(for_restart=True)
            elif changed:
                if self.config["server_backend"] == "remote_control":
                    sync_krfb_config(self.config)
                self.tray.showMessage(
                    "VNC Settings Saved",
                    f"{backend_label(self.config['server_backend'])} • Port {self.config['port']}",
                    QtWidgets.QSystemTrayIcon.MessageIcon.Information,
                    2500,
                )
        self._settings_dialog = None

    def open_connection_info(self) -> None:
        """Open or focus the iPhone connection guide & copy helper window."""
        if self._info_dialog is None:
            self._info_dialog = ConnectionInfoDialog(self)
        self._info_dialog.refresh()
        self._info_dialog.show()
        self._info_dialog.raise_()
        self._info_dialog.activateWindow()

    def open_logs(self) -> None:
        """Open or focus the status & live log viewer window."""
        if self._log_dialog is None:
            self._log_dialog = LogViewerDialog(self)
        self._log_dialog.refresh()
        self._log_dialog.show()
        self._log_dialog.raise_()
        self._log_dialog.activateWindow()

    def launch_local_viewer(self, _retry: bool = False) -> None:
        """Launch local VNC viewer on Kali to preview the virtual 2nd screen."""
        viewer = (
            shutil.which("xtigervncviewer")
            or shutil.which("vncviewer")
            or shutil.which("xtightvncviewer")
        )
        if not viewer:
            QtWidgets.QMessageBox.information(
                None,
                "No Local VNC Viewer Found",
                "Install tigervnc-viewer (via installer.py) to preview locally.",
            )
            return
        if not self.is_active():
            if _retry:
                return
            self.start_service()
            if self.is_active():
                QtCore.QTimer.singleShot(1400, lambda: self.launch_local_viewer(_retry=True))
            return
        subprocess.Popen(
            [viewer, f"127.0.0.1::{self.config['port']}"],
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    def quit_app(self) -> None:
        """Stop VNC server cleanly (if running) and exit the tray application."""
        self._layout_timer.stop()
        self._startup_poll_timer.stop()
        if self.is_active():
            self._manual_stop = True
            self.process.terminate()
            self.process.waitForFinished(1800)
            if self.is_active():
                self.process.kill()
        self.tray.hide()
        self.app.quit()


def send_ipc_if_already_running(command: str) -> bool:
    """Return True if an active tray instance accepted the IPC command."""
    sock = QtNetwork.QLocalSocket()
    sock.connectToServer(IPC_SERVER_NAME)
    if not sock.waitForConnected(250):
        return False
    sock.write(command.encode("utf-8"))
    sock.flush()
    sock.waitForBytesWritten(250)
    sock.disconnectFromServer()
    return True


def main() -> int:
    if "--sync-config" in sys.argv[1:]:
        cfg = load_config()
        save_config(cfg)
        if not sync_krfb_config(cfg):
            print("Warning: could not update ~/.config/krfbrc (kwriteconfig not found).", file=sys.stderr)
            return 1
        return 0

    app = QtWidgets.QApplication(sys.argv)
    app.setApplicationName("vnc-tray")
    app.setApplicationDisplayName("VNC 2nd Display")
    app.setDesktopFileName("vnc-tray")
    app.setQuitOnLastWindowClosed(False)

    if "--toggle" in sys.argv[1:]:
        if send_ipc_if_already_running("TOGGLE"):
            return 0
    elif send_ipc_if_already_running("SHOW_SETTINGS"):
        return 0

    if not QtWidgets.QSystemTrayIcon.isSystemTrayAvailable():
        QtWidgets.QMessageBox.critical(
            None,
            "System Tray Unavailable",
            "No system tray was detected in this desktop session.",
        )
        return 1

    signal.signal(signal.SIGINT, signal.SIG_DFL)
    controller = VncTrayApp(app)
    app.aboutToQuit.connect(
        lambda: controller.process.terminate() if controller.is_active() else None
    )
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
