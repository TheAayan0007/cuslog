def sanitize_display_name(raw: str) -> str:
    """Return a clean virtual monitor identifier safe for KWin/CLI args."""
    cleaned = re.sub(r"[^A-Za-z0-9_-]", "", raw.strip())
    return cleaned or DEFAULT_CONFIG["display_name"]


def generate_password(length: int = 8) -> str:
    """Generate an easy-to-type 8-character alphanumeric VNC password."""
    alphabet = "abcdefghjkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789"
    return "".join(secrets.choice(alphabet) for _ in range(length))


def load_config() -> dict[str, Any]:
    """Load persistent VNC display settings with safe defaults."""
    cfg = dict(DEFAULT_CONFIG)
    if CONFIG_FILE.exists():
        try:
            loaded = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
            if isinstance(loaded, dict):
                cfg.update(loaded)
        except (OSError, json.JSONDecodeError):
            pass

    valid_backends = {b for b, _ in SERVER_BACKENDS}
    backend = str(cfg.get("server_backend", "remote_control")).lower()
    cfg["server_backend"] = backend if backend in valid_backends else "remote_control"

    password = str(cfg.get("password", "")).strip()
    cfg["password"] = password or DEFAULT_CONFIG["password"]
    cfg["allow_unattended"] = bool(cfg.get("allow_unattended", True))
    try:
        port = int(cfg.get("port", 5900))
    except (TypeError, ValueError):
        port = 5900
    cfg["port"] = max(5900, min(5999, port))
    cfg["display_name"] = sanitize_display_name(str(cfg.get("display_name", "")))

    valid_modes = {m for m, _ in LAYOUT_CHOICES}
    mode = str(cfg.get("layout_mode", "right")).lower()
    cfg["layout_mode"] = mode if mode in valid_modes else "right"

    for dim, fallback in (("width", 1280), ("height", 720)):
        try:
            val = int(cfg.get(dim, fallback))
        except (TypeError, ValueError):
            val = fallback
        cfg[dim] = max(320, min(3840, val))

    try:
        scale = float(cfg.get("scale", 1.0))
    except (TypeError, ValueError):
        scale = 1.0
    cfg["scale"] = scale if scale in SCALE_CHOICES else 1.0
    cfg["auto_start_service"] = bool(cfg.get("auto_start_service", False))
    return cfg


def obscure_krfb_password(password: str) -> str:
    """Encode password with KDE's KStringHandler::obscure() for krfbrc."""
    return "".join(chr(0x1001F - ord(ch)) if ord(ch) >= 0x22 else ch for ch in password)


def sync_krfb_config(cfg: dict[str, Any]) -> bool:
    """Write krfbrc settings so krfb enables mouse/keyboard control and VNC auth."""
    kwrite = shutil.which("kwriteconfig6") or shutil.which("kwriteconfig5")
    if not kwrite:
        return False

    port = int(cfg["port"])
    pw = cfg["password"]
    unattended = bool(cfg.get("allow_unattended", True))
    # Keep normal vs unattended passwords distinct so unattended auth auto-accepts cleanly.
    unattended_pw = obscure_krfb_password(pw) if unattended else ""
    desktop_pw = obscure_krfb_password(generate_password(12) if unattended else pw)
    fb_plugin = "pw" if is_wayland_session() else "xcb"

    for stale_key in ("unattendedAccessPassword", "desktopSharingPassword"):
        subprocess.run(
            [kwrite, "--file", "krfbrc", "--group", "Security", "--key", stale_key, "--delete"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    entries = [
        ("Security", "allowDesktopControl", "bool", "true"),
        ("Security", "noWallet", "bool", "true"),
        ("Security", "allowUnattendedAccess", "bool", "true" if unattended else "false"),
        ("Security", "unattendedPassword", None, unattended_pw),
        ("Security", "desktopPassword", None, desktop_pw),
        ("FrameBuffer", "preferredFrameBufferPlugin", None, fb_plugin),
        ("TCP", "useDefaultPort", "bool", "true" if port == 5900 else "false"),
        ("TCP", "port", None, str(port)),
        ("TCP", "publishService", "bool", "true"),
        ("MainWindow", "startMinimized", "bool", "true"),
    ]
    for group, key, val_type, val in entries:
        cmd = [kwrite, "--file", "krfbrc", "--group", group, "--key", key]
        if val_type:
            cmd.extend(["--type", val_type])
        cmd.append(val)
        res = subprocess.run(cmd, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if res.returncode != 0:
            return False
    return True


def save_config(cfg: dict[str, Any]) -> None:
    """Persist configuration atomically to user config directory."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    tmp_file = CONFIG_FILE.with_suffix(".tmp")
    tmp_file.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    os.chmod(tmp_file, 0o600)
    tmp_file.replace(CONFIG_FILE)


def get_primary_ip() -> str:
    """Best-effort lookup of the primary LAN IPv4 address."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            sock.connect(("1.1.1.1", 80))
            return sock.getsockname()[0]
    except OSError:
        ips = get_all_local_ips()
        return ips[0][1] if ips else "127.0.0.1"


def get_all_local_ips() -> list[tuple[str, str]]:
    """Return list of (interface, ipv4) pairs for active non-loopback interfaces."""
    results: list[tuple[str, str]] = []
    if shutil.which("ip"):
        try:
            out = subprocess.check_output(
                ["ip", "-4", "-o", "addr", "show", "scope", "global"],
                text=True,
                stderr=subprocess.DEVNULL,
            )
            for line in out.splitlines():
                parts = line.split()
                if len(parts) >= 4 and parts[2] == "inet":
                    iface = parts[1]
                    ip_addr = parts[3].split("/")[0]
                    results.append((iface, ip_addr))
        except subprocess.SubprocessError:
            pass
    return results


def is_wayland_session() -> bool:
    """Return True if the current desktop session is running on Wayland."""
    return (
        os.environ.get("XDG_SESSION_TYPE", "").lower() == "wayland"
        or bool(os.environ.get("WAYLAND_DISPLAY"))
    )


def get_kscreen_outputs() -> list[dict[str, Any]]:
    """Query current displays from KDE kscreen-doctor JSON output."""
    if not shutil.which("kscreen-doctor"):
        return []
    try:
        res = subprocess.run(
            ["kscreen-doctor", "-j"],
            capture_output=True,
            text=True,
            check=False,
            timeout=5,
        )
        if res.returncode != 0 or not res.stdout.strip():
            return []
        data = json.loads(res.stdout)
        outputs = data.get("outputs", [])
        return outputs if isinstance(outputs, list) else []
    except (subprocess.SubprocessError, json.JSONDecodeError):
        return []


def logical_size(output: dict[str, Any]) -> tuple[int, int]:
    """Return logical (width, height) of a KScreen output accounting for scale."""
    size = output.get("size") or {}
    w = int(size.get("width", 1366) or 1366)
    h = int(size.get("height", 768) or 768)
    scale = float(output.get("scale", 1.0) or 1.0)
    if scale > 0:
        return max(1, int(round(w / scale))), max(1, int(round(h / scale)))
    return w, h


def find_external_krfb_pids() -> list[tuple[int, str]]:
    """Return (pid, exe_name) pairs for running krfb or krfb-virtualmonitor processes."""
    matches: list[tuple[int, str]] = []
    my_pid = os.getpid()
    proc_dir = Path("/proc")
    try:
        entries = list(proc_dir.iterdir())
    except OSError:
        return matches

    for entry in entries:
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        if pid == my_pid:
            continue
        try:
            cmdline_raw = (entry / "cmdline").read_bytes()
        except OSError:
            continue
        if not cmdline_raw:
            continue
        first_arg = cmdline_raw.split(b"\x00", 1)[0].decode("utf-8", errors="ignore")
        exe_name = os.path.basename(first_arg)
        if exe_name in ("krfb", "krfb-virtualmonitor"):
            matches.append((pid, exe_name))
    return matches


def is_port_in_use(port: int) -> bool:
    """Return True if a TCP listener is already bound on the given port."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.settimeout(0.25)
        return sock.connect_ex(("127.0.0.1", port)) == 0


def backend_label(backend: str) -> str:
    """Return short human-readable label for a server backend key."""
    if backend == "remote_control":
        return "Mouse & Keyboard ON"
    return "2nd Display (View Only)"


def layout_label(mode: str) -> str:
    """Return human-readable label for a layout mode key."""
    for key, label in LAYOUT_CHOICES:
        if key == mode:
            return label.split(" (")[0]
    return mode.capitalize()


def build_tray_icon(state: str) -> QtGui.QIcon:
    """Render a crisp dual-display (laptop + iPhone) icon reflecting VNC server state."""
    icon = QtGui.QIcon()
    for size in (22, 32, 48, 64):
        pixmap = QtGui.QPixmap(size, size)
        pixmap.fill(QtCore.Qt.GlobalColor.transparent)

        painter = QtGui.QPainter(pixmap)
        painter.setRenderHint(QtGui.QPainter.RenderHint.Antialiasing)
        scale = size / 64.0
        painter.scale(scale, scale)

        if state == "running":
            laptop_color = QtGui.QColor("#e2e8f0")
            phone_color = QtGui.QColor("#38bdf8")
            badge_color = QtGui.QColor("#22c55e")
        elif state == "starting":
            laptop_color = QtGui.QColor("#e2e8f0")
            phone_color = QtGui.QColor("#fbbf24")
            badge_color = QtGui.QColor("#f59e0b")
        elif state == "error":
            laptop_color = QtGui.QColor("#fca5a5")
            phone_color = QtGui.QColor("#ef4444")
            badge_color = QtGui.QColor("#ef4444")
        else:
            laptop_color = QtGui.QColor("#cbd5e1")
            phone_color = QtGui.QColor("#94a3b8")
            badge_color = None

        # Laptop monitor on the left
        pen = QtGui.QPen(laptop_color, 4.2)
        pen.setCapStyle(QtCore.Qt.PenCapStyle.RoundCap)
        pen.setJoinStyle(QtCore.Qt.PenJoinStyle.RoundJoin)
        painter.setPen(pen)
        painter.setBrush(QtGui.QColor("#0f172a"))
        painter.drawRoundedRect(QtCore.QRectF(7.0, 14.0, 30.0, 23.0), 3.5, 3.5)
        painter.drawLine(QtCore.QPointF(22.0, 37.0), QtCore.QPointF(22.0, 44.0))
        painter.drawLine(QtCore.QPointF(14.0, 44.0), QtCore.QPointF(30.0, 44.0))

        # iPhone 2nd screen on the right
        phone_pen = QtGui.QPen(phone_color, 4.2)
        phone_pen.setCapStyle(QtCore.Qt.PenCapStyle.RoundCap)
        phone_pen.setJoinStyle(QtCore.Qt.PenJoinStyle.RoundJoin)
        painter.setPen(phone_pen)
        painter.setBrush(QtGui.QColor("#0f172a"))
        painter.drawRoundedRect(QtCore.QRectF(36.0, 19.0, 21.0, 33.0), 4.5, 4.5)

        # Tiny home bar inside phone screen
        painter.setPen(QtCore.Qt.PenStyle.NoPen)
        painter.setBrush(phone_color)
        painter.drawRoundedRect(QtCore.QRectF(42.5, 46.0, 8.0, 2.2), 1.0, 1.0)

        # Status dot in bottom-right corner
        if badge_color is not None:
            painter.setPen(QtGui.QPen(QtGui.QColor("#0f172a"), 2.4))
            painter.setBrush(badge_color)
            painter.drawEllipse(QtCore.QRectF(44.0, 42.0, 15.0, 15.0))

        painter.end()
        icon.addPixmap(pixmap)
    return icon


