def load_config() -> dict[str, Any]:
    """Load persistent tray/UxPlay settings, falling back to defaults."""
    cfg = dict(DEFAULT_CONFIG)
    if CONFIG_FILE.exists():
        try:
            loaded = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
            if isinstance(loaded, dict):
                cfg.update(loaded)
        except (OSError, json.JSONDecodeError):
            pass
    name = str(cfg.get("name", "")).strip()
    cfg["name"] = name or DEFAULT_CONFIG["name"]
    cfg["hide_hostname"] = bool(cfg.get("hide_hostname", True))
    cfg["fullscreen"] = bool(cfg.get("fullscreen", False))
    cfg["use_pin"] = bool(cfg.get("use_pin", False))
    cfg["pin_code"] = re.sub(r"\D", "", str(cfg.get("pin_code", "")))[:4]
    cfg["auto_start_service"] = bool(cfg.get("auto_start_service", False))
    return cfg


def save_config(cfg: dict[str, Any]) -> None:
    """Persist configuration atomically to user config directory."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    tmp_file = CONFIG_FILE.with_suffix(".tmp")
    tmp_file.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    tmp_file.replace(CONFIG_FILE)


def visible_airplay_name(cfg: dict[str, Any]) -> str:
    """Return the AirPlay display name as seen from an iPhone."""
    base = cfg["name"]
    if cfg.get("hide_hostname", True):
        return base
    return f"{base}@{socket.gethostname()}"


def build_tray_icon(state: str) -> QtGui.QIcon:
    """Render a crisp AirPlay icon for the top bar reflecting service state."""
    icon = QtGui.QIcon()
    for size in (22, 32, 48, 64):
        pixmap = QtGui.QPixmap(size, size)
        pixmap.fill(QtCore.Qt.GlobalColor.transparent)

        painter = QtGui.QPainter(pixmap)
        painter.setRenderHint(QtGui.QPainter.RenderHint.Antialiasing)

        scale = size / 64.0
        painter.scale(scale, scale)

        if state == "running":
            screen_color = QtGui.QColor("#38bdf8")
            triangle_color = QtGui.QColor("#22c55e")
            badge_color = QtGui.QColor("#22c55e")
        elif state == "starting":
            screen_color = QtGui.QColor("#fbbf24")
            triangle_color = QtGui.QColor("#fbbf24")
            badge_color = QtGui.QColor("#f59e0b")
        elif state == "error":
            screen_color = QtGui.QColor("#f87171")
            triangle_color = QtGui.QColor("#ef4444")
            badge_color = QtGui.QColor("#ef4444")
        else:
            screen_color = QtGui.QColor("#cbd5e1")
            triangle_color = QtGui.QColor("#94a3b8")
            badge_color = None

        # Draw outer TV/display frame with bottom notch for the AirPlay triangle
        pen = QtGui.QPen(screen_color, 5.2)
        pen.setCapStyle(QtCore.Qt.PenCapStyle.RoundCap)
        pen.setJoinStyle(QtCore.Qt.PenJoinStyle.RoundJoin)
        painter.setPen(pen)
        painter.setBrush(QtCore.Qt.BrushStyle.NoBrush)

        frame_path = QtGui.QPainterPath()
        frame_path.moveTo(21, 44)
        frame_path.lineTo(13, 44)
        frame_path.quadTo(9, 44, 9, 40)
        frame_path.lineTo(9, 16)
        frame_path.quadTo(9, 12, 13, 12)
        frame_path.lineTo(51, 12)
        frame_path.quadTo(55, 12, 55, 16)
        frame_path.lineTo(55, 40)
        frame_path.quadTo(55, 44, 51, 44)
        frame_path.lineTo(43, 44)
        painter.drawPath(frame_path)

        # Draw bottom AirPlay triangle
        painter.setPen(QtGui.QPen(QtGui.QColor("#0f172a"), 1.6))
        painter.setBrush(triangle_color)
        tri = QtGui.QPolygonF(
            [
                QtCore.QPointF(32.0, 31.0),
                QtCore.QPointF(45.5, 51.5),
                QtCore.QPointF(18.5, 51.5),
            ]
        )
        painter.drawPolygon(tri)

        # Draw small status indicator badge in bottom-right when active/starting/error
        if badge_color is not None:
            painter.setPen(QtGui.QPen(QtGui.QColor("#0f172a"), 2.5))
            painter.setBrush(badge_color)
            painter.drawEllipse(QtCore.QRectF(43.0, 41.0, 15.0, 15.0))

        painter.end()
        icon.addPixmap(pixmap)
    return icon


def find_external_uxplay_pids() -> list[int]:
    """Return PIDs of running uxplay processes not owned by this tray instance."""
    try:
        out = subprocess.check_output(["pgrep", "-x", "uxplay"], text=True).strip()
    except subprocess.CalledProcessError:
        return []
    return [int(line) for line in out.splitlines() if line.strip().isdigit()]


def is_avahi_active() -> bool:
    """Return True if systemd avahi-daemon service is active."""
    res = subprocess.run(
        ["systemctl", "is-active", "--quiet", "avahi-daemon"],
        check=False,
    )
    return res.returncode == 0


def get_primary_ip() -> str:
    """Best-effort lookup of non-loopback local IPv4 address for display."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            sock.connect(("1.1.1.1", 80))
            return sock.getsockname()[0]
    except OSError:
        return "localhost"


class SettingsDialog(QtWidgets.QDialog):
    """GUI dialog for editing the AirPlay name and mirroring options."""

    def __init__(self, cfg: dict[str, Any], is_running: bool, parent=None) -> None:
        super().__init__(parent)
        self.setWindowTitle("AirPlay Settings — UxPlay")
        self.setWindowIcon(build_tray_icon("running" if is_running else "stopped"))
        self.setMinimumWidth(410)
        self.setStyleSheet(DARK_DIALOG_STYLE)

        layout = QtWidgets.QVBoxLayout(self)
        layout.setSpacing(12)
        layout.setContentsMargins(18, 18, 18, 18)

        title = QtWidgets.QLabel("Edit AirPlay Receiver Name")
        title.setStyleSheet("font-size: 15px; font-weight: 600; color: #f9fafb;")
        layout.addWidget(title)

        name_label = QtWidgets.QLabel("Device name shown on iPhone / iPad:")
        layout.addWidget(name_label)

        self.name_edit = QtWidgets.QLineEdit(cfg["name"])
        self.name_edit.setPlaceholderText("e.g. kaliaayan2")
        self.name_edit.selectAll()
        layout.addWidget(self.name_edit)

        self.preview_label = QtWidgets.QLabel()
        self.preview_label.setStyleSheet("color: #38bdf8; font-size: 12px;")
        layout.addWidget(self.preview_label)

        self.hide_host_cb = QtWidgets.QCheckBox(
            f"Clean name (do not append @{socket.gethostname()})"
        )
        self.hide_host_cb.setChecked(cfg.get("hide_hostname", True))
        layout.addWidget(self.hide_host_cb)

        self.fullscreen_cb = QtWidgets.QCheckBox("Start mirroring window in fullscreen (-fs)")
        self.fullscreen_cb.setChecked(cfg.get("fullscreen", False))
        layout.addWidget(self.fullscreen_cb)

        pin_row = QtWidgets.QHBoxLayout()
        self.pin_cb = QtWidgets.QCheckBox("Require PIN code (-pin):")
        self.pin_cb.setChecked(cfg.get("use_pin", False))
        self.pin_edit = QtWidgets.QLineEdit(cfg.get("pin_code", ""))
        self.pin_edit.setPlaceholderText("4 digits or blank=random")
        self.pin_edit.setMaxLength(4)
        self.pin_edit.setEnabled(self.pin_cb.isChecked())
        pin_row.addWidget(self.pin_cb)
        pin_row.addWidget(self.pin_edit)
        layout.addLayout(pin_row)

        self.autostart_service_cb = QtWidgets.QCheckBox(
            "Auto-start AirPlay server when tray icon opens at login"
        )
        self.autostart_service_cb.setChecked(cfg.get("auto_start_service", False))
        layout.addWidget(self.autostart_service_cb)

        self.name_edit.textChanged.connect(self._update_preview)
        self.hide_host_cb.toggled.connect(self._update_preview)
        self.pin_cb.toggled.connect(self.pin_edit.setEnabled)
        self._update_preview()

        btn_row = QtWidgets.QHBoxLayout()
        btn_row.addStretch()

        cancel_btn = QtWidgets.QPushButton("Cancel")
        cancel_btn.clicked.connect(self.reject)
        btn_row.addWidget(cancel_btn)

        save_label = "Save & Restart AirPlay" if is_running else "Save"
        save_btn = QtWidgets.QPushButton(save_label)
        save_btn.setObjectName("primaryBtn")
        save_btn.setDefault(True)
        save_btn.clicked.connect(self._on_accept)
        btn_row.addWidget(save_btn)

        layout.addLayout(btn_row)

    def _update_preview(self) -> None:
        raw = self.name_edit.text().strip() or DEFAULT_CONFIG["name"]
        shown = raw if self.hide_host_cb.isChecked() else f"{raw}@{socket.gethostname()}"
        self.preview_label.setText(f"Visible on iPhone as: {shown}")

    def _on_accept(self) -> None:
        name = self.name_edit.text().strip()
        if not name:
            QtWidgets.QMessageBox.warning(
                self, "Invalid Name", "AirPlay name cannot be empty."
            )
            self.name_edit.setFocus()
            return

        pin_raw = self.pin_edit.text().strip()
        if self.pin_cb.isChecked() and pin_raw and not re.fullmatch(r"\d{4}", pin_raw):
            QtWidgets.QMessageBox.warning(
                self,
                "Invalid PIN",
                "PIN must be exactly 4 digits, or leave blank for a random PIN.",
            )
            self.pin_edit.setFocus()
            return
        self.accept()

    def result_config(self) -> dict[str, Any]:
        """Return validated settings dictionary from the form."""
        return {
            "name": self.name_edit.text().strip(),
            "hide_hostname": self.hide_host_cb.isChecked(),
            "fullscreen": self.fullscreen_cb.isChecked(),
            "use_pin": self.pin_cb.isChecked(),
            "pin_code": self.pin_edit.text().strip(),
            "auto_start_service": self.autostart_service_cb.isChecked(),
        }


